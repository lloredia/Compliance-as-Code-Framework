{
  "resource_changes": [
    {
      "address": "module.cloudtrail.aws_cloudtrail.main",
      "mode": "managed",
      "type": "aws_cloudtrail",
      "change": {
        "actions": ["create"],
        "after": {
          "is_multi_region_trail": true,
          "enable_log_file_validation": true,
          "enable_logging": true
        }
      }
    },
    {
      "address": "module.s3_security.aws_s3_account_public_access_block.this",
      "mode": "managed",
      "type": "aws_s3_account_public_access_block",
      "change": {
        "actions": ["create"],
        "after": {
          "block_public_acls": true,
          "block_public_policy": true,
          "ignore_public_acls": true,
          "restrict_public_buckets": true
        }
      }
    },
    {
      "address": "aws_security_group_rule.https",
      "mode": "managed",
      "type": "aws_security_group_rule",
      "change": {
        "actions": ["create"],
        "after": {
          "from_port": 443,
          "to_port": 443,
          "cidr_blocks": ["10.1.0.0/16"],
          "ipv6_cidr_blocks": []
        }
      }
    }
  ]
}
