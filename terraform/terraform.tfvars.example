# Copy to terraform.tfvars (gitignored) and edit.

aws_region   = "us-east-1"
environment  = "dev"
project_name = "compliance"

cloudtrail_retention_days = 365
flowlog_retention_days    = 365

# Names of pre-existing buckets to encrypt and lock down. Leave empty for
# account-level Block Public Access only.
existing_s3_bucket_names = []

# Leave empty to create the alarm topic without an email subscription.
notification_email = ""

tags = {
  Owner      = "SecurityTeam"
  CostCenter = "Security"
  Compliance = "CIS"
}
