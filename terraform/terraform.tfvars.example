# Copy to terraform.tfvars (gitignored) and edit.

aws_region   = "us-east-1"
environment  = "dev"
project_name = "compliance"

cloudtrail_retention_days = 365
flowlog_retention_days    = 30

# Set true only after reviewing which pre-existing buckets would be adopted.
manage_existing_s3_buckets = false

# Leave empty to create the alarm topic without an email subscription.
notification_email = ""

tags = {
  Owner      = "SecurityTeam"
  CostCenter = "Security"
  Compliance = "CIS"
}
