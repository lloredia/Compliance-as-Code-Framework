# Copy to backend.hcl (gitignored) and edit before:
#   terraform init -backend-config=backend.hcl
#
# Create the bucket and lock table before init. The bucket needs versioning,
# KMS or SSE-S3 encryption, and Block Public Access. The DynamoDB table uses
# a string partition key named LockID.
#
#   aws s3api create-bucket --bucket your-terraform-state-bucket --region us-east-1
#   aws s3api put-bucket-versioning --bucket your-terraform-state-bucket \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name terraform-state-lock \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST

bucket         = "your-terraform-state-bucket"
key            = "compliance/terraform.tfstate"
region         = "us-east-1"
encrypt        = true
dynamodb_table = "terraform-state-lock"
